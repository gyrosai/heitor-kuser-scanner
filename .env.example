# ── Backend (FastAPI / Railway) ────────────────────────────────────────────
# Token dos endpoints administrativos de materiais (/api/admin/*).
# Enviado no header X-Admin-Token. Vazio = admin desabilitado (todo request 401).
# Gere um valor forte, ex: openssl rand -hex 32
ADMIN_TOKEN="your_admin_token_here"
